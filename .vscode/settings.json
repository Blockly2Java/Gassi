{
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.import.gradle.enabled": true,
    "java.compile.nullAnalysis.mode": "automatic",
    "java.server.launchMode": "Standard",
    "java.project.importOnFirstTimeOpen": "automatic",
    "java.import.gradle.builder.enabled": true,
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    "files.exclude": {
        "**/gradlew*": true,
        "**/gradle": true,
        "**/.gradle": true,
        "**/bin": true,
        "**/build": true,
        "**/out": true,
        "**/target": true
    },
    "search.exclude": {
        "**/gradlew*": true,
        "**/gradle": true,
        "**/.gradle": true,
        "**/bin": true,
        "**/build": true,
        "**/out": true,
        "**/target": true
    },
    "files.watcherExclude": {
        "**/gradlew*": true,
        "**/gradle": true,
        "**/.gradle": true,
        "**/bin": true,
        "**/build": true,
        "**/out": true,
        "**/target": true
    }
}